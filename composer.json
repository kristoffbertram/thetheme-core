{
    "name": "kristoffbertram/thetheme-core",
    "description": "Engine for the shared thetheme_* WordPress scaffold: module runtime, subsite resolver, ACF block loader.",
    "type": "library",
    "license": "MIT",
    "keywords": ["wordpress", "theme", "acf", "scaffold"],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "KristoffBertram\\ThethemeCore\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
